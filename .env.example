# ─── Gateway ────────────────────────────────────────────
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=50051

BACKEND_SERVERS=server1=localhost:50052,server2=localhost:50053

HEALTH_CHECK_INTERVAL_S=5.0
REQUEST_TIMEOUT_S=10.0
LOG_LEVEL=INFO

# ─── TLS (Unused) ────────────────────────────
TLS_ENABLED=false
# TLS_CA_CERT=/certs/ca.crt
# TLS_CLIENT_CERT=/certs/client.crt
# TLS_CLIENT_KEY=/certs/client.key

# ─── Server ─────────────────────────────────────────────
SERVER_HOST=0.0.0.0
SERVER_PORT=50052
SERVER_ID=server1
ARTIFICIAL_DELAY_MS=0
ARTIFICIAL_DELAY_MAX_MS=0
OUTPUT_ROWS=6
OUTPUT_COLS=1

# ─── CLI ────────────────────────────────────────────────
GATEWAY_ADDR=localhost:50051
